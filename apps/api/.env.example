# --- Database (Prisma / SQL Server) ---
# Local dev on this machine uses the SQLEXPRESS instance on TCP 11433 (not 1433).
DATABASE_URL="sqlserver://localhost:11433;database=RFQ_DB;user=SA;password=SA@11;encrypt=true;trustServerCertificate=true"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"

# --- AI (Phase 4 Spec Analysis) ---
# Leave as a placeholder to use the deterministic mock extractor.
ANTHROPIC_API_KEY="sk-ant-"
# SPEC_MODEL="claude-opus-5"

# --- Server ---
PORT=4000
NODE_ENV="development"

# --- Production only ---
# Comma-separated allowed browser origins for CORS.
# WEB_ORIGIN="https://rfq.example.com"
# Absolute path to the built web app (apps/web/dist) to serve the SPA from this process.
