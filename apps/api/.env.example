# --- Database (Prisma / SQL Server) ---
# Local dev on this machine uses the SQLEXPRESS instance on TCP 11433 (not 1433).
DATABASE_URL="sqlserver://localhost:11433;database=RFQ_DB;user=SA;password=SA@11;encrypt=true;trustServerCertificate=true"

# --- Auth ---
# REQUIRED. At least 32 random characters, e.g.:  openssl rand -hex 48
# In production (NODE_ENV=production) the API refuses to start if this is missing, a
# placeholder, or shorter than 32 characters. In development it only warns.
JWT_SECRET="change-me-to-a-long-random-string"

# --- AI (Spec Analysis) ---
# A real key starting with "sk-ant-" enables live drawing extraction (needs credit on the account).
# While this is still the placeholder, PDFs are read from their own text (free, no AI: drawing no.,
# item name, material grade, units, stock size) and labelled "read from PDF text". Scans / images
# are refused with a clear message — nothing is ever fabricated.
ANTHROPIC_API_KEY="sk-ant-"
# SPEC_EXTRACTOR=text   # read only the PDF's own text (no AI call, no cost) even when a key is set
# Demos / automated tests only: with no real key, return one canned sample shaft for EVERY file
# (flagged "sample data"). Leave unset when you are testing real drawings.
# SPEC_ALLOW_MOCK=true
# Extraction model (default: claude-opus-5). Any current Claude model with PDF/vision input works.
# SPEC_MODEL="claude-opus-5"

# --- Server ---
PORT=4000
NODE_ENV="development"

# --- Production only ---
# Comma-separated allowed browser origins for CORS.
# WEB_ORIGIN="https://rfq.example.com"
# Absolute path to the built web app (apps/web/dist) to serve the SPA from this process.
# WEB_DIST="/srv/rfq/web/dist"
